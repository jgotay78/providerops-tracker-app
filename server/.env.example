# ProviderOps Tracker backend
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
FROM_EMAIL="ProviderOps Tracker <no-reply@providerops.local>"
REPLY_TO_EMAIL=credentialing@providerops.local

# Preferred production email provider (optional)
RESEND_API_KEY=

# SMTP/Nodemailer fallback (optional)
# If neither Resend nor SMTP credentials are configured, the app uses demo-json transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
